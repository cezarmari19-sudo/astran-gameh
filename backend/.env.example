MONGO_URL=
DB_NAME=
JWT_SECRET=
# --- GDPR (stergere cont / export date) - vezi PRIVACY_GDPR.md -------------------------------------
# Cheie pentru pseudonimele din datele pastrate dupa stergere (HMAC). Daca lipseste, se deriva din JWT_SECRET.
# Schimbarea ei ulterior rupe corelarea pseudonimelor deja scrise: seteaz-o o singura data, in productie.
# PRIVACY_PSEUDONYM_KEY=
# Perioade de pastrare (zile) pentru datele pseudonimizate. Valorile implicite sunt DOAR puncte de plecare:
# se confirma cu un jurist inainte de productie.
# PRIVACY_FINANCIAL_RETENTION_DAYS=1825
# PRIVACY_MODERATION_RETENTION_DAYS=365
# PRIVACY_AUDIT_RETENTION_DAYS=365
# Valabilitatea tichetului de descarcare a exportului (secunde, min 30)
# PRIVACY_EXPORT_TTL_SECONDS=600