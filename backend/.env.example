MONGO_URL=
DB_NAME=
JWT_SECRET=
# --- GDPR (stergere cont / export date) - vezi PRIVACY_GDPR.md -------------------------------------
# Cheie pentru pseudonimele din datele pastrate dupa stergere (HMAC). Daca lipseste, se deriva din JWT_SECRET.
# Schimbarea ei ulterior rupe corelarea pseudonimelor deja scrise: seteaz-o o singura data, in productie.
# PRIVACY_PSEUDONYM_KEY=
# Perioade de pastrare (zile) pentru datele pseudonimizate. Valorile implicite sunt DOAR puncte de plecare:
# se confirma cu un jurist inainte de productie.
# PRIVACY_FINANCIAL_RETENTION_DAYS=1825
# PRIVACY_MODERATION_RETENTION_DAYS=365
# PRIVACY_AUDIT_RETENTION_DAYS=365
# Valabilitatea tichetului de descarcare a exportului (secunde, min 30)
# PRIVACY_EXPORT_TTL_SECONDS=600
# ---- VARSTA / ACORD PARENTAL / AGE ASSURANCE (vezi AGE_PARENTAL_COMPLIANCE.md) ----
# Cheie pentru criptarea datei nasterii si a emailului parintelui (Fernet, 32 octeti urlsafe-base64). Recomandat SEPARAT de JWT_SECRET.
# AGE_DATA_KEY=
# URL public al aplicatiei (linkurile din emailul catre parinte: /parental/decision?token=...)
# ASTRAN_PUBLIC_APP_URL=https://app.example.com
# Sub 16 ani: cont blocat pana la acord parental (implicit 1; temeiul exact se valideaza juridic)
# ASTRAN_UNDER16_BLOCK_UNTIL_PARENTAL=1
# Conturi vechi fara data nasterii: dupa aceasta data (YYYY-MM-DD) devin RESTRANSE pana introduc data. Gol = nu se blocheaza.
# ASTRAN_AGE_INFO_DEADLINE=
# Verificare suplimentara a calitatii de parinte (provider extern, atestare semnata HMAC). Fara ele contul ramane in PARENTAL_VERIFICATION_REQUIRED.
# ASTRAN_PARENTAL_VERIFIER=signed_attestation
# ASTRAN_PARENTAL_VERIFIER_SECRET=
# ASTRAN_PARENTAL_VERIFIER_START_URL=https://provider.example/parent-verify
# ASTRAN_PARENTAL_VERIFIER_METHOD=card_micro_charge
# Age assurance 18+ (provider extern, atestare semnata HMAC). Fara ele accesul 18+ ramane BLOCAT pentru toti.
# ASTRAN_AGE_ASSURANCE_PROVIDER=signed_webhook
# ASTRAN_AGE_ASSURANCE_SECRET=
# ASTRAN_AGE_ASSURANCE_START_URL=https://provider.example/age/start
# ASTRAN_AGE_ASSURANCE_NAME=
