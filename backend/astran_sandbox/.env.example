# Cos de gunoi: stergere definitiva automata (implicit 30 zile; minim 1) si intervalul jobului (secunde, minim 60)
# TRASH_RETENTION_DAYS=30
# TRASH_PURGE_INTERVAL_SECONDS=3600
# --- Drepturile consumatorilor UE (consumer.py / refunds.py) -------------------------------------------------
# Identitatea comerciantului (Directiva 2011/83/UE art. 6). Fara nume + adresa + email, achizitiile cu plata sunt BLOCATE
# (fail-closed) cat timp CONSUMER_ENFORCE_TRADER_INFO != 0. NU inventa date: completeaza cu cele reale ale operatorului.
CONSUMER_TRADER_NAME=
CONSUMER_TRADER_ADDRESS=
CONSUMER_TRADER_EMAIL=
CONSUMER_TRADER_PHONE=
CONSUMER_TRADER_REG_NO=
CONSUMER_TRADER_VAT_ID=
CONSUMER_ENFORCE_TRADER_INFO=1
# Stripe: folosit si pentru rambursari reale (POST /v1/refunds, cheie de idempotenta = refund_id)
# STRIPE_SECRET_KEY=